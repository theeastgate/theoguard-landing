# Resend — https://resend.com/
# Create an API key in the Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Resend Audience ID
# Create an audience in Resend → Audiences, then copy the ID
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Site URL (used for canonical URLs and OG tags)
# Set to your production domain in Vercel/deployment env
NEXT_PUBLIC_SITE_URL=https://theoguard.com
